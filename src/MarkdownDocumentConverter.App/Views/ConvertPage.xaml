<Page
    x:Class="MarkdownDocumentConverter.App.Views.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:MarkdownDocumentConverter.App.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Padding="24,20,24,24"
            HorizontalAlignment="Stretch"
            Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Markdown 转换" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="将 Markdown 转换为 Word 和 PDF。全部转换在本机离线完成。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                MinHeight="120"
                Padding="20"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Text="将 Markdown 文件或文件夹拖到这里"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button x:Name="AddFilesButton" Click="AddFiles_Click" Content="添加文件" />
                        <Button x:Name="AddFolderButton" Click="AddFolder_Click" Content="添加文件夹" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="StartButton"
                    Command="{x:Bind ViewModel.StartCommand}"
                    Content="开始转换"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="CancelButton"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Content="取消" />
                <Button
                    x:Name="RetryButton"
                    Command="{x:Bind ViewModel.RetryFailedCommand}"
                    Content="重试失败项" />
                <Button
                    x:Name="ClearButton"
                    Command="{x:Bind ViewModel.ClearCommand}"
                    Content="清空列表" />
            </StackPanel>

            <Border
                Height="220"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListView
                    x:Name="Queue"
                    HorizontalContentAlignment="Stretch"
                    DoubleTapped="Queue_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.Files}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:FileItemViewModel">
                            <Grid Padding="8,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Directory}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind SizeText}" />
                                <Button
                                    Grid.Column="3"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind RetryCommand}"
                                    Content="重试"
                                    FontSize="12"
                                    Visibility="{x:Bind IsRetryVisible, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="输出格式" />
                        <CheckBox
                            Content="Word (.docx)"
                            IsChecked="{x:Bind ViewModel.ConvertWord, Mode=TwoWay}" />
                        <CheckBox
                            Content="PDF (.pdf)"
                            IsChecked="{x:Bind ViewModel.ConvertPdf, Mode=TwoWay}" />
                    </StackPanel>

                    <ToggleSwitch
                        Header="输出到源文件目录"
                        IsOn="{x:Bind ViewModel.UseSourceDirectory, Mode=TwoWay}" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.OutputDirectorySummary, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="ChooseOutputButton"
                            Grid.Column="1"
                            Click="ChooseOutputDirectory_Click"
                            Content="选择输出目录" />
                    </Grid>

                    <Grid
                        ColumnSpacing="16"
                        RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="页面" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display"
                                ItemsSource="{x:Bind ViewModel.PageSizeOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedPageSize, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="风格" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display"
                                ItemsSource="{x:Bind ViewModel.StyleOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedStyle, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="字体" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display"
                                ItemsSource="{x:Bind ViewModel.FontOptions}"
                                MaxDropDownHeight="360"
                                SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="字号比例" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display"
                                ItemsSource="{x:Bind ViewModel.FontScaleOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedFontScale, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <ProgressBar
                Maximum="100"
                Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
