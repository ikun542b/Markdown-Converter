<Page
    x:Class="MarkdownDocumentConverter.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="900"
            Padding="32,24,32,32"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="设置" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="默认值会应用到新添加的转换任务。设置为本地保存，不会上传。" />
            </StackPanel>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="常规" />

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <TextBlock
                            Width="140"
                            VerticalAlignment="Center"
                            Text="默认输出格式" />
                        <CheckBox
                            Content="Word (.docx)"
                            IsChecked="{x:Bind ViewModel.DefaultWord, Mode=TwoWay}" />
                        <CheckBox
                            Content="PDF (.pdf)"
                            IsChecked="{x:Bind ViewModel.DefaultPdf, Mode=TwoWay}" />
                    </StackPanel>

                    <ToggleSwitch
                        Header="输出到源文件目录"
                        IsOn="{x:Bind ViewModel.UseSourceDirectory, Mode=TwoWay}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            IsReadOnly="True"
                            PlaceholderText="指定输出目录"
                            Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}" />
                        <Button
                            x:Name="ChooseOutputButton"
                            Grid.Column="1"
                            Click="ChooseOutputDirectory_Click"
                            Content="选择目录" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <ToggleSwitch
                            MinWidth="180"
                            Header="递归扫描子目录"
                            IsOn="{x:Bind ViewModel.Recursive, Mode=TwoWay}" />
                        <ToggleSwitch
                            MinWidth="220"
                            Header="完成后打开输出目录"
                            IsOn="{x:Bind ViewModel.OpenOutputFolderAfterComplete, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            Width="140"
                            VerticalAlignment="Center"
                            Text="同名文件处理" />
                        <ComboBox
                            Width="200"
                            DisplayMemberPath="Display"
                            ItemsSource="{x:Bind ViewModel.OverwritePolicyOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedOverwritePolicy, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="排版" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="默认页面" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display"
                                ItemsSource="{x:Bind ViewModel.PageSizeOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedPageSize, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="默认风格" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display"
                                ItemsSource="{x:Bind ViewModel.StyleOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedStyle, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="默认字体" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display"
                                ItemsSource="{x:Bind ViewModel.FontOptions}"
                                MaxDropDownHeight="360"
                                SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="默认字号比例" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display"
                                ItemsSource="{x:Bind ViewModel.FontScaleOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedFontScale, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="高级" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            Width="140"
                            VerticalAlignment="Center"
                            Text="最大并发任务数" />
                        <ComboBox
                            Width="140"
                            DisplayMemberPath="Display"
                            ItemsSource="{x:Bind ViewModel.ParallelJobOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedParallelJobs, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button
                    x:Name="SaveButton"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="保存设置"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
