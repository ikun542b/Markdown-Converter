<Window
    x:Class="MarkdownDocumentConverter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Markdown Document Converter">

    <NavigationView
        x:Name="Navigation"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="False"
        IsSettingsVisible="False"
        Loaded="Navigation_Loaded"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="ConvertNavItem" Content="转换" IsSelected="True" Tag="convert">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <ContentControl
            x:Name="ContentHost"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </NavigationView>
</Window>
